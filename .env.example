APP_NAME="AI Journal"
DEBUG=false

# Paths — relative to repo root when running locally; overridden to /app/data/* in Docker
DB_PATH=data/journal.db
CHROMA_PATH=data/chroma

# HuggingFace models
EMBEDDING_MODEL=all-MiniLM-L6-v2
NER_MODEL=dslim/bert-base-NER
ROBERTA_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_TOKEN=

# Ollama — use http://ollama:11434 when running inside Docker Compose
OLLAMA_URL=http://localhost:11434

# CORS origins (JSON array) — add your React dev server origin here
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
